# ==========================================
# SERVER CONFIG
# ==========================================
NODE_ENV=
PORT=
JWT_SECRET=
REFRESH_SECRET=
SERVER_MODE=
LOCAL_IP=(auto inserted by .\setup.bat)
LOCAL_DOMAIN=(auto inserted by .\setup.bat)
BIND_ADDRESS=0.0.0.0
HTTPS_PORT=your_HTTPS_preffered_port
HTTP_PORT=your_HTTP_preffered_port
USE_JSREPORT_FALLBACK=
PDF_TAB_POOL_SIZE=
PDF_FONT_WAIT_MS=


# ==========================================
# DATABASE TYPE (leave empty for auto-detect)
# ==========================================
DB_TYPE=


# ==========================================
# REDDIS SETUP
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SOCKET=
REDIS_ENABLED=true


# ==========================================
# GITHUB SETUP
# ==========================================
GITHUB_PAT=your_personal_access_token
GITHUB_REPO=hicadsystems/DSA-PAYROLL
GITHUB_RUNNER_TOKEN=XXXXXXXXXXXXXXXXXX
RUNNER_LABEL=dsa-payroll


# ==========================================
# CLOUDINARY SETUP
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ==========================================
# MYSQL CONFIGURATION
# ==========================================
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_POOL_SIZE_PER_DB=

MYSQL_DB_OFFICERS=
MYSQL_DB_WOFFICERS=
MYSQL_DB_RATINGS=
MYSQL_DB_RATINGS_A=
MYSQL_DB_RATINGS_B=
MYSQL_DB_JUNIOR_TRAINEE=


# ==========================================
# MSSQL CONFIGURATION
# ==========================================
MSSQL_HOST=
MSSQL_PORT=
MSSQL_USER=
MSSQL_PASSWORD=

MSSQL_DB_OFFICERS=
MSSQL_DB_WOFFICERS=
MSSQL_DB_RATINGS=
MSSQL_DB_RATINGS_A=
MSSQL_DB_RATINGS_B=
MSSQL_DB_JUNIOR_TRAINEE=

# ==========================================
# PDF GENERATION (lib/pdfGate.js, lib/chromiumPdfGenerator.js)
# ==========================================
# One shared Chromium renders every PDF in the app, this many at a time.
# 2 suits a 2 GB server; raise only with more memory.
PDF_MAX_CONCURRENT=2
# Personnel payslips allowed to wait for a slot, and for how long.
# Beyond that: 503 + Retry-After and the payslip page retries by itself.
PDF_MAX_WAITING=12
PDF_MAX_WAIT_MS=20000
# Close the shared browser after this long idle; restart it after this many pages.
PDF_BROWSER_IDLE_MS=120000
PDF_BROWSER_MAX_PAGES=300
# jsreport starts a new Chrome per PDF: off unless set to true.
PDF_USE_JSREPORT=false
# Coolify / Docker: path to system Chromium. cPanel: leave empty (Sparticuz).
PDF_CHROMIUM_EXECUTABLE=

# ==========================================
# ASYNC EXPORTS (long PDF/Excel jobs behind Cloudflare)
# ==========================================
ASYNC_EXPORT_ENABLED=true
ASYNC_EXPORT_INLINE_MS=30000
ASYNC_EXPORT_MAX_CONCURRENT=3
ASYNC_EXPORT_JOB_TIMEOUT_MS=1800000
ASYNC_EXPORT_TTL_MS=1800000
